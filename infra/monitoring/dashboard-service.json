{
  "id": null,
  "uid": "spacecube-service",
  "title": "서비스 · 서버 상태",
  "tags": [
    "spacecube",
    "F-65"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "7대 호스트 상태",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"nodes\"}",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "서버별 요청 수",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server) (rate(http_requests_total[5m]))",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "요청 p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,server) (rate(http_request_duration_highr_seconds_bucket[5m])))",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "5xx 오류율 (정상 슬롯 충돌 409 제외)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server) (rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum by (server) (rate(http_requests_total[5m])) - (sum by (server) (rate(reservation_total{result=\"conflict\"}[5m])) or on(server) (0 * sum by (server) (rate(http_requests_total[5m])))), 0.001)",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "HAProxy가 보는 API 서버 상태 (1=정상, 0=이상)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "noValue": "수집 없음",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (server) (haproxy_server_status{proxy=\"apps\",server=~\"api1|api2\",state=\"UP\"}) or (0 * max by (server) (haproxy_server_status{proxy=\"apps\",server=~\"api1|api2\"}))",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "HAProxy 서버별 분산 요청 (/초)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server) (rate(haproxy_server_loadbalanced_total{proxy=\"apps\",server=~\"api1|api2\"}[$__rate_interval]))",
          "legendFormat": "{{server}}"
        }
      ]
    }
  ]
}
