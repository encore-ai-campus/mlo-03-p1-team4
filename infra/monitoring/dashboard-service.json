{
  "id": null,
  "uid": "spacecube-service",
  "title": "서비스 · 서버 상태",
  "tags": [
    "spacecube",
    "F-65"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "7대 호스트 상태",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spacecube-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"node\"}",
          "legendFormat": "{{vm}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "서버별 요청 수",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spacecube-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (vm) (rate(http_requests_total[5m]))",
          "legendFormat": "{{vm}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "요청 p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spacecube-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,vm) (rate(http_request_duration_highr_seconds_bucket[5m])))",
          "legendFormat": "{{vm}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "5xx 오류율 (정상 슬롯 충돌 409 제외)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spacecube-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (vm) (rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum by (vm) (rate(http_requests_total[5m])) - (sum by (vm) (rate(reservation_total{result=\"conflict\"}[5m])) or on(vm) (0 * sum by (vm) (rate(http_requests_total[5m])))), 0.001)",
          "legendFormat": "{{vm}}"
        }
      ]
    }
  ]
}
