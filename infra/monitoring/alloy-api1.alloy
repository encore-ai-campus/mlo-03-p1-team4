logging { level = "info" }
loki.write "local" {
  endpoint { url = "http://mon:3100/loki/api/v1/push" }
}
loki.source.journal "system" {
  max_age = "1h"
  labels = { job = "journal", server = "api1", vm = "api1", source = "journal" }
  forward_to = [loki.write.local.receiver]
}\nlocal.file_match "api_logs" {
  path_targets = [
    { __path__ = "/opt/spacecube/backend/logs/app.log", job = "api", server = "api1", vm = "api1", source = "app" },
    { __path__ = "/opt/spacecube/backend/logs/events.log", job = "api", server = "api1", vm = "api1", source = "events" },
  ]
}
loki.source.file "api_logs" {
  targets = local.file_match.api_logs.targets
  forward_to = [loki.write.local.receiver]
}
local.file_match "nginx_access" {
  path_targets = [
    { __path__ = "/var/log/nginx/spacecube-access.log", job = "nginx", server = "api1", vm = "api1", source = "nginx_access" },
  ]
}
loki.source.file "nginx_access" {
  targets = local.file_match.nginx_access.targets
  forward_to = [loki.write.local.receiver]
}