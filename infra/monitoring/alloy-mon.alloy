prometheus.remote_write "mon" {
  external_labels = { vm = "mon" }
  endpoint { url = "http://mon:9090/api/v1/write" }
}
loki.write "mon" {
  endpoint { url = "http://mon:3100/loki/api/v1/push" }
}
prometheus.exporter.unix "host" {}
prometheus.scrape "node" {
  targets = prometheus.exporter.unix.host.targets
  job_name = "node"
  forward_to = [prometheus.remote_write.mon.receiver]
}
loki.source.journal "system" {
  labels = { vm = "mon", source = "journal" }
  forward_to = [loki.write.mon.receiver]
}
