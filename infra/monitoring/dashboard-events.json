      },
      "options": {
        "mode": "markdown",
        "content": "### 이벤트 수신\nevents.log 실제 구조 또는 이벤트 수신 counter 확인 대기\n실제 /metrics 샘플 확인 후 쿼리를 연결합니다."
      }
    },
    {
      "id": 2,
      "title": "MongoDB 쓰기 실패",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spacecube-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (vm) (increase(mongo_event_write_failures_total[5m]))",
          "legendFormat": "{{vm}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "replica 읽기 대체",
      "type": "timeseries",
      "datasource": {
