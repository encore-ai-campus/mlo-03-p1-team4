{
  "uid": "spacecube-mariadb",
  "title": "Spacecube / MariaDB primary · replica",
  "schemaVersion": 39,
  "version": 101,
  "refresh": "15s",
  "tags": [
    "spacecube"
  ],
  "panels": [
    {
      "id": 1,
      "title": "DB exporter 정상 대수",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mysql_up{job=\"mariadb\"})",
          "legendFormat": "",
          "instant": true,
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "수집 없음",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "horizontal",
        "text": {
          "valueSize": 16,
          "titleSize": 11
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 2
      }
    },
