{
  "uid": "spacecube-overview",
  "title": "Spacecube / 전체 현황",
  "schemaVersion": 39,
  "version": 8,
  "refresh": "15s",
  "tags": [
    "spacecube"
  ],
  "panels": [
    {
      "id": 1,
      "title": "기간 총 요청 · 정적 파일 포함",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(nginx_http_requests_total[$__range]))",
          "legendFormat": "{{server}}",
          "instant": true,
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "수집 없음",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "horizontal",
        "text": {
          "valueSize": 26,
          "titleSize": 11
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 3
      }
    },
    {
      "id": 2,
      "title": "전체 RPS · 정적 파일 포함",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(nginx_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{server}}",
          "instant": true,
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "수집 없음",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
