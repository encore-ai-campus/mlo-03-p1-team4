    {
      "id": 7008,
      "title": "API 응답 p95",
      "type": "stat",
      "description": "현재 수집 워커의 전체 API 지연. 조회 300ms 가이드이며 업무별 실험 p95와 구분합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
