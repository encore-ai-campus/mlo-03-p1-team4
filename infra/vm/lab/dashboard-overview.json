    {
      "id": 600,
      "title": "서비스·백엔드 상태 이력",
      "description": "1=정상, 0=비정상. Prometheus 수집 상태와 HAProxy의 앱 서버 헬스체크를 함께 봅니다.",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(server,job)(up{job=~\"alloy|api|haproxy|loki|mariadb|nginx|nodes|prometheus\"})",
          "legendFormat": "{{server}} · {{job}}"
        },
        {
          "refId": "B",
          "expr": "haproxy_server_status{proxy=\"apps\",state=\"UP\"}",
          "legendFormat": "{{server}} · HAProxy backend"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 1,
          "noValue": "수집 없음",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN / STOPPED",
                  "color": "red"
                },
                "1": {
                  "text": "UP / RUNNING",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "rowHeight": 0.8,
        "tooltip": {
          "mode": "single"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 6
