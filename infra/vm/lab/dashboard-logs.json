{
  "uid": "spacecube-logs",
  "title": "Spacecube / 로그 탐색",
  "schemaVersion": 39,
  "version": 103,
  "refresh": "15s",
  "tags": [
    "spacecube",
    "lab"
  ],
  "panels": [
    {
      "id": 1,
      "title": "전체 로그",
      "description": "",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{server=~\"gw|api1|api2|mon\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 1,
          "noValue": "수집 없음"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      }
    },
    {
      "id": 2,
      "title": "FastAPI 오류·503·동시성 제한",
      "description": "",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"api\",server=~\"api1|api2\"} |~ \"(?i)(ERROR|Exception|Traceback|503|Exceeded concurrency limit)\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 1,
          "noValue": "수집 없음"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 9
      }
    },
    {
      "id": 3,
      "title": "Nginx API 5xx 접근 로그",
      "description": "",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"nginx\",server=~\"api1|api2\"} | json | __error__=\"\" | path=~\"/api/.*\" | path!~\"/api/(health|metrics).*\" | status=~\"5..\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 1,
          "noValue": "수집 없음"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 9
      }
    },
    {
      "id": 4,
      "title": "서버·수집기 오류 로그",
      "description": "",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"journal\",server=~\"gw|api1|api2|mon\"} |~ \"(?i)(error|failed|down|retry|drop)\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 1,
          "noValue": "수집 없음"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      }
    }
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "같은 시간 범위에서 API 오류, Nginx 5xx, 시스템·수집기 로그를 확인합니다.",
