{
  "uid": "spacecube-storage",
  "title": "Spacecube / 저장소·이벤트 (연결 대기)",
  "schemaVersion": 39,
  "version": 8,
  "refresh": "15s",
  "tags": [
    "spacecube",
    "lab"
  ],
  "panels": [
    {
      "id": 900,
      "type": "text",
      "title": "DB 수집 대기",
      "options": {
        "mode": "markdown",
        "content": "MariaDB 앱 연결은 정상입니다. DB exporter 설치 대기라 용량·연결·복제 지표는 아직 없습니다. MongoDB는 이번 시험에서 제외했습니다. 아래 FastAPI 지표는 수집된 워커 기준입니다."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "수집 없음",
          "unit": "short"
        }
      }
    },
    {
      "id": 1,
      "title": "Replica 대체 횟수 · 수집된 워커",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "db_read_fallback_total",
          "interval": "15s",
          "legendFormat": "{{server}} · {{instance}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          },
          "noValue": "수집 없음",
          "min": 0,
          "decimals": 0,
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "MongoDB 전달 실패 — 연결 대기",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mongo_event_write_failures_total",
          "interval": "15s",
          "legendFormat": "{{server}} · {{instance}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          },
          "noValue": "수집 없음",
          "min": 0,
          "decimals": 0,
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "title": "MariaDB 복제 지연 — exporter 대기",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_slave_status_seconds_behind_master",
          "interval": "15s",
          "legendFormat": "{{server}} · {{instance}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          },
          "noValue": "수집 없음",
          "min": 0,
          "decimals": 0,
          "unit": "short"
        }
      }
    }
  ],
  "time": {
    "from": "now-30m",
