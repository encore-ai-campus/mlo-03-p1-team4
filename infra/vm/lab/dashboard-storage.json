      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_requests_total{job=\"api\",handler=\"/events\",status=\"202\"}[$__range]))",
          "instant": true
