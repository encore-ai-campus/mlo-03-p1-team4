{
  "uid": "spacecube-servers",
  "title": "Spacecube / 서버·프록시",
  "schemaVersion": 39,
  "version": 8,
  "refresh": "15s",
  "tags": [
    "spacecube",
    "lab"
  ],
  "panels": [
    {
      "id": 1,
      "title": "정상 수집 대상 수",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up)",
          "instant": true,
          "interval": "15s",
          "legendFormat": "{{server}} · {{instance}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 3
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "horizontal",
        "text": {
          "valueSize": 16,
          "titleSize": 11
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "수집 없음",
          "min": 0,
          "decimals": 0,
          "unit": "short"
        }
      }
    },
    {
      "id": 5,
      "title": "HAProxy 백엔드 상태",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "haproxy_server_status{proxy=\"apps\",state=\"UP\"}",
          "instant": true,
          "interval": "15s",
          "legendFormat": "{{server}} · {{instance}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 3
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "text": {
          "valueSize": 16,
          "titleSize": 11
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "수집 없음",
          "min": 0,
          "decimals": 0,
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "CPU 사용률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by(server)(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])))",
          "interval": "15s",
          "legendFormat": "{{server}} · {{instance}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 7
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          },
          "noValue": "수집 없음",
          "min": 0,
          "decimals": 1,
          "unit": "percent",
          "max": 100
        }
      }
    },
    {
      "id": 3,
      "title": "메모리 사용률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes/node_memory_MemTotal_bytes)",
          "interval": "15s",
          "legendFormat": "{{server}} · {{instance}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 7
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          },
          "noValue": "수집 없음",
          "min": 0,
          "decimals": 1,
          "unit": "percent",
          "max": 100
        }
      }
    },
    {
      "id": 4,
      "title": "루트 디스크 여유",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"}",
          "interval": "15s",
          "legendFormat": "{{server}} · {{instance}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 7
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          },
          "noValue": "수집 없음",
          "min": 0,
          "decimals": 1,
          "unit": "bytes"
        }
      }
    },
    {
      "id": 6,
      "title": "Nginx 접속",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nginx_connections_active",
          "interval": "15s",
          "legendFormat": "{{server}} · {{instance}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 7
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          },
          "noValue": "수집 없음",
          "min": 0,
          "decimals": 0,
          "unit": "short"
        }
      }
    }
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "109 최소 사양 시험. DB exporter 설치 대기·MongoDB 제외. FastAPI 지표는 현재 수집 워커 기준. 빈 구간은 0을 뜻하지 않습니다.",
