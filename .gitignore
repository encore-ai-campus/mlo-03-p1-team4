# 비밀값: 예시(.env.example)만 올린다
.env
.env.*
!.env.example

# 파이썬
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.venv/

# 프론트 (frontend/.gitignore에도 있음)
node_modules/
dist/
coverage/
playwright-report/
test-results/
.eslintcache

# 실행 중 생기는 것
.playwright-mcp/
*.zip
logs/
*.log

# 글꼴 원본(용량 큼, design/fonts/README.md의 배포처에서 다시 받음)
design/fonts/*/original/

# 편집기·OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# 크롤링 표본 원본(업체 이름 포함) — 공개 저장소에 올리지 않는다. 가공값은 MongoDB crawl_raw에
crawler/data/
