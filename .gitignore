# 비밀값: 예시(.env.example)만 올린다
.env
.env.*
!.env.example

# 파이썬
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.venv/
.f61-testdeps/

# 프론트 (frontend/.gitignore에도 있음)
node_modules/
postman/environments/Local.private.environment.yaml
dist/
coverage/
playwright-report/
test-results/
.eslintcache

# 실행 중 생기는 것
.playwright-mcp/
*.zip
logs/
*.log

# 글꼴 원본(용량 큼, design/fonts/README.md의 배포처에서 다시 받음)
design/fonts/*/original/

# 편집기·OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# 크롤러 실행 기준선은 설명 문서만 추적하고, 현장 표본·실행 상태는 저장소에 올리지 않는다.
crawler/data/*
!crawler/data/README.md

# 각자 PC의 Claude Code 미리보기 설정
.claude/launch.json

# 디자인 점검 스킬(design-taste-frontend) 측정·스크린샷 출력
.taste-skill/
