    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "verify": "run-s lint \"test:unit -- --run\" build",
    "lint:colors": "node scripts/check-colors.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.66.0",
    "@vueuse/core": "^15.0.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "~1.90.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-vue": "~10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.90.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  }
