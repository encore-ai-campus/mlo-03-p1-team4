<mxfile host="app.diagrams.net"><diagram id="haproxy" name="HAProxy 비교"><mxGraphModel dx="1600" dy="960" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="920" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="대량 사용자 분산: HAProxy를 어디에 둘까" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0F172A;fontFamily=Noto Sans KR;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="c3" value="다락큐브 1차(로컬 VM 7대) 기준. 두 안 모두 DB 층은 같고, 차이는 &quot;정문에서 FastAPI까지&quot; 입니다." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#475569;whiteSpace=wrap;fontFamily=Noto Sans KR;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c4" value="A안  사용자 → Nginx → HAProxy → FastAPI" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=18;fontStyle=1;fontColor=#0F172A;fontFamily=Noto Sans KR;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="760" height="800" as="geometry"/></mxCell><mxCell id="c5" value="사용자 브라우저 (대량)&#xa;Playwright · Locust 포함" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#1E1B4B;fontFamily=Noto Sans KR;" vertex="1" parent="1"><mxGeometry x="290" y="140" width="220" height="56" as="geometry"/></mxCell><mxCell id="c6" value="gw VM (노트북 1)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#64748B;dashed=1;dashPattern=6 4;strokeWidth=1.5;verticalAlign=top;align=right;spacingRight=10;spacingTop=4;fontSize=13;fontColor=#334155;fontFamily=Noto Sans KR;" vertex="1" parent="1"><mxGeometry x="110" y="230" width="580" height="150" as="geometry"/></mxCell><