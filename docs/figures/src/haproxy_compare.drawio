" y="620" width="30" height="30" as="geometry"/></mxCell><mxCell id="c47" value="" style="shape=image;html=1;verticalLabelPosition=bottom;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1484" y="620" width="30" height="30" as="geometry"/></mxCell><mxCell id="c48" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="c34" target="c45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c49" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="c39" target="c45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c50" value="좋은 점&#xa;· 진입은 HAProxy 한 겹: 분산과 /health 확인을 한 곳에서&#xa;· 정적 파일은 서버마다 Nginx가 나눠 맡아 gw 부담이 작음&#xa;· 서버(Nginx + FastAPI)를 하나 더 붙이면 HAProxy에 한 줄 추가로 확장&#xa;· 실무 구조(로드밸런서 → 웹서버 → 앱)와 같아 설명하기 쉬움&#xa;&#xa;남는 위험&#xa;· gw 한 대는 여전히 단일 장애점(실서비스는 HAProxy 2대 + keepalived 가상 IP)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fontSize=13;fontColor=#1E293B;fontFamily=Noto Sans KR;" vertex="1" parent="1"><mxGeometry x="860" y="700" width="680" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>