# 백엔드 설정 키 이름. 복사해서 backend/.env로 쓰고 값을 채운다. .env는 git에 올리지 않는다.
# 키 설명: docs/백엔드_A_회원_후기_이벤트.md 2절, docs/백엔드_B_공간_예약_결제_크롤링.md

# MariaDB primary(쓰기·인증·내 것) / replica(공개 조회). DB_READ_URL을 비우면 primary 하나로 돈다(로컬)
# 로컬 compose(infra/local): mysql+pymysql://app:<infra/local/.env의 MARIADB_PASSWORD>@127.0.0.1:3308/spacecube?charset=utf8mb4
DB_WRITE_URL=
DB_READ_URL=

# MongoDB (user_events). 인증 포함 주소. 로컬 compose는 mongodb://127.0.0.1:27017 (인증 없음)
MONGO_URL=
MONGO_DB=spacecube

# 토큰
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# 크롤러 → POST /internal/venues
INTERNAL_API_KEY=

# 가상 데이터 헤더 X-Synthetic: 1과 함께 X-Synthetic-Key로 보냄(Locust·Playwright·데이터 생성기). INTERNAL_API_KEY와 다른 값
SYNTHETIC_API_KEY=

# 로그 파일 위치와 서버 이름(api-1 / api-2)
LOG_DIR=./logs
SERVER_NAME=api-1

# 프론트 개발 서버 주소 (쉼표로 여러 개)
CORS_ORIGINS=http://localhost:5173

# 예약 가능 범위(오늘 기준 과거·미래 일 수). 지난 날짜·시간도 예약 가능(11-03 결정)
BOOKING_PAST_DAYS=365
BOOKING_FUTURE_DAYS=365

# 비우면 실제 날짜. 테스트에서만 YYYY-MM-DD로 고정 (가상 날짜 아님)
TODAY_OVERRIDE=
